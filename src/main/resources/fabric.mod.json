{
	"schemaVersion": 1,
	"id": "resourcepack-loader",
	"version": "${version}",
	"name": "Resource Pack Loader",
	"description": "Automatically enable/disable resource packs based on the server you join. (Unofficial 26.2 fork of Anom-uxx's original mod)",
	"authors": [
		"Anom-uxx",
		"MCforevers"
	],
	"contact": {
		"homepage": "https://github.com/Anom-uxx/Resourcepack-loader-"
	},
	"license": "MIT",
	"icon": "assets/logo.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.anomuxx.resourcepackloader.ResourcePackLoader"
		],
		"modmenu": [
			"com.anomuxx.resourcepackloader.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": "~26.2",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*"
	}
}
